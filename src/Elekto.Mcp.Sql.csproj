<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AssemblyName>Elekto.Mcp.Sql</AssemblyName>
    <RootNamespace>Elekto.Mcp.Sql</RootNamespace>
    <SelfContained>false</SelfContained>

    <!-- NuGet global tool, listed on nuget.org as an MCP server (packagetype=mcpserver) -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>elekto-mcp-sql</ToolCommandName>
    <PackageType>McpServer</PackageType>

    <!-- Package identity -->
    <PackageId>Elekto.Mcp.Sql</PackageId>
    <Version>2.3.2</Version>
    <Authors>Elekto Produtos Financeiros</Authors>
    <Copyright>Copyright © 2026 Elekto Produtos Financeiros</Copyright>

    <!-- Package description and discoverability -->
    <Description>
      Read-only MCP server for SQL Server 2017+ introspection and querying.
      Exposes schema metadata, DDL definitions, dependency graphs, index health diagnostics,
      data profiling and data queries via the Model Context Protocol (stdio transport),
      enabling AI assistants such as GitHub Copilot and Claude to understand your database
      structure without storing credentials in the repository.
      Zero-config for .NET projects: automatically reads ConnectionStrings from
      appsettings.json, web.config and App.config.
    </Description>
    <PackageTags>mcp;sql-server;database;introspection;schema;copilot;claude;ai;readonly;modelcontextprotocol;devtools</PackageTags>

    <!-- Source and license -->
    <PackageProjectUrl>https://github.com/elekto-com-br/elekto-mcp-sql</PackageProjectUrl>
    <RepositoryUrl>https://github.com/elekto-com-br/elekto-mcp-sql</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>

    <!-- README and icon shown on nuget.org -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>elekto_logo_sq.300x300.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Elekto.Mcp.Sql.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\assets\elekto_logo_sq.300x300.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    .mcp/server.json tells nuget.org how to start the server (its "MCP Server" tab) and states the
    package version twice. The file in the repository carries $version$ in both places, and this
    target writes the packed copy with the version being packed, so the manifest cannot disagree
    with the package it ships in.
  -->
  <PropertyGroup>
    <BeforePack>$(BeforePack);GenerateMcpServerManifest</BeforePack>
  </PropertyGroup>

  <Target Name="GenerateMcpServerManifest">
    <PropertyGroup>
      <McpServerManifestOutput>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'server.json'))</McpServerManifestOutput>
    </PropertyGroup>

    <WriteVersionedFile Source="$(MSBuildProjectDirectory)/.mcp/server.json"
                        Destination="$(McpServerManifestOutput)"
                        PackageVersion="$(Version)" />

    <ItemGroup>
      <None Include="$(McpServerManifestOutput)" Pack="true" PackagePath="/.mcp/" />
    </ItemGroup>
  </Target>

  <!--
    A task rather than WriteLinesToFile: on Linux and macOS that one takes its lines for paths and
    turns every backslash into a slash, which would corrupt any JSON escape when CI packs.
  -->
  <UsingTask TaskName="WriteVersionedFile"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
      <PackageVersion ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        var text = File.ReadAllText(Source).Replace("$version$", PackageVersion);
        Directory.CreateDirectory(Path.GetDirectoryName(Destination));
        File.WriteAllText(Destination, text);
      ]]></Code>
    </Task>
  </UsingTask>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>

</Project>
